# Copy to .env. Never commit or share the populated file.
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Exact external origin, without a trailing slash. For local testing only:
PUBLIC_URL=http://localhost:8080
TIMEZONE=America/New_York
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_SECRET=
DATABASE_PATH=data/tracker.db
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28
# Defaults to a backups directory beside DATABASE_PATH. Use another mounted volume if available.
# BACKUP_DIRECTORY=/app/data/backups

# Permit HTTP webhook registration only for an explicit pilot (HTTPS is preferred).
ALLOW_HTTP=true

