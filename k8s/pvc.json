{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "cet-time-data",
    "namespace": "cet-time",
    "labels": {
      "app.kubernetes.io/name": "cet-time"
    }
  },
  "spec": {
    "accessModes": [
      "ReadWriteMany"
    ],
    "resources": {
      "requests": {
        "storage": "5Gi"
      }
    },
    "storageClassName": "",
    "volumeName": "cet-time-nfs-pv"
  }
}
