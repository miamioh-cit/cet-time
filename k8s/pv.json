{
  "apiVersion": "v1",
  "kind": "PersistentVolume",
  "metadata": {
    "name": "cet-time-nfs-pv",
    "labels": {
      "app.kubernetes.io/name": "cet-time"
    }
  },
  "spec": {
    "capacity": {
      "storage": "5Gi"
    },
    "volumeMode": "Filesystem",
    "accessModes": [
      "ReadWriteMany"
    ],
    "persistentVolumeReclaimPolicy": "Retain",
    "storageClassName": "",
    "claimRef": {
      "namespace": "cet-time",
      "name": "cet-time-data"
    },
    "nfs": {
      "server": "10.48.228.25",
      "path": "/srv/nfs/roseaw"
    }
  }
}
